# WhatsRook Environment Configuration

# WhatsApp Session Phone Number
SESSION=2348000000000

# Client Platform: chrome (default), android, ios
CLIENT=chrome

# Connection Options
PAIR=true
QRCODE=false
VERBOSE=false

# Database Configuration (PostgreSQL primary with SQLite fallback)
# Supabase managed PostgreSQL example: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local PostgreSQL example: postgres://postgres:postgres@localhost:5432/whatsrook?sslmode=disable
# Set to "sqlite" to explicitly force SQLite storage
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsrook?sslmode=disable
